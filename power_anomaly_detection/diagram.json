{
  "version": 1,
  "author": "Power Anomaly & Theft Detector",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 100, "left": 150, "attrs": {} },
    {
      "type": "wokwi-lcd1602",
      "id": "lcd",
      "top": -80,
      "left": 120,
      "attrs": { "pins": "i2c" }
    },
    {
      "type": "wokwi-potentiometer",
      "id": "pot_voltage",
      "top": 120,
      "left": -120,
      "attrs": { "label": "Voltage Sim (GPIO 35)" }
    },
    {
      "type": "wokwi-potentiometer",
      "id": "pot_current",
      "top": 280,
      "left": -120,
      "attrs": { "label": "Current Sim (GPIO 34)" }
    },
    {
      "type": "wokwi-buzzer",
      "id": "buzzer",
      "top": 280,
      "left": 400,
      "attrs": { "volume": "0.1" }
    }
  ],
  "connections": [
    [ "esp:GND.1", "lcd:GND", "black", [ "v0" ] ],
    [ "esp:5V", "lcd:VCC", "red", [ "v0" ] ],
    [ "esp:21", "lcd:SDA", "green", [ "v0" ] ],
    [ "esp:22", "lcd:SCL", "yellow", [ "v0" ] ],

    [ "esp:3V3", "pot_voltage:VCC", "red", [ "v0" ] ],
    [ "esp:GND.2", "pot_voltage:GND", "black", [ "v0" ] ],
    [ "esp:35", "pot_voltage:SIG", "blue", [ "v0" ] ],

    [ "esp:3V3", "pot_current:VCC", "red", [ "v0" ] ],
    [ "esp:GND.2", "pot_current:GND", "black", [ "v0" ] ],
    [ "esp:34", "pot_current:SIG", "orange", [ "v0" ] ],

    [ "esp:25", "buzzer:2", "purple", [ "v0" ] ],
    [ "esp:GND.3", "buzzer:1", "black", [ "v0" ] ]
  ],
  "dependencies": {}
}
